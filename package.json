{
  "name": "react-stream-player",
  "version": "0.1.0",
  "description": "React 19 video player for progressive MP4, HLS and DASH (Shaka Player) with the Artplayer UI, multiple subtitles, quality/audio selection, direct and VAST (Google IMA) ads, live DVR, fullscreen, hotkeys and Media Session.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "react",
    "video",
    "player",
    "hls",
    "dash",
    "shaka-player",
    "artplayer",
    "drm",
    "vast",
    "ima",
    "subtitles",
    "nextjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenji-07/react-stream-player.git"
  },
  "bugs": {
    "url": "https://github.com/kenji-07/react-stream-player/issues"
  },
  "homepage": "https://github.com/kenji-07/react-stream-player#readme",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "fixtures": "bash scripts/generate-fixtures.sh",
    "fixtures:h264": "FIXTURE_CODEC=h264 bash scripts/generate-fixtures.sh",
    "serve:fixtures": "node scripts/fixture-server.mjs",
    "prototype:build": "node examples/integration-prototype/build.mjs",
    "prototype:gate": "npm run prototype:build && node examples/integration-prototype/run-gate.mjs",
    "consumers": "node scripts/consumer-smoke.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "dependencies": {
    "artplayer": "5.4.0",
    "shaka-player": "~5.2.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/react": "^16.3.3",
    "@types/google_interactive_media_ads_types": "^3.697.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
