{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "..",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": [
      "node",
      "google_interactive_media_ads_types"
    ],
    "skipLibCheck": true,
    "paths": {
      "react-stream-player": [
        "../src/index.ts"
      ],
      "react-stream-player/core": [
        "../src/core.ts"
      ],
      "react-stream-player/styles.css": [
        "../src/styles.css"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "unit",
    "types",
    "e2e",
    "../src",
    "../examples/nextjs/components",
    "../playwright.config.ts",
    "../vitest.config.ts"
  ]
}
